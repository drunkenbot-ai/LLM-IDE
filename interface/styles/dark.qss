/* DrunkenBot IDE - Modern Obsidian Luxury Dark Theme */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

QMainWindow, QWidget#AppShell, QStackedWidget {
    background: #0c0d12;
    color: #f1f5f9;
}

QWidget#TopBar {
    background: #10121a;
    border-bottom: 1px solid #1c202e;
}

QWidget#SideRail {
    background: #0d0e14;
    border-right: 1px solid #1a1c27;
}

QWidget#Panel, QWidget#Page, QWidget#PageContent {
    background: #0c0d12;
    color: #f1f5f9;
}

QWidget#Card {
    background: #151821;
    border: 1px solid #232738;
    border-radius: 12px;
}

QWidget#LossChart {
    background: #11131c;
    border: 1px solid #232738;
    border-radius: 10px;
}

QLabel {
    color: #cbd5e1;
    font-size: 13px;
}

QLabel#Logo {
    color: #f59e0b;
    font-size: 22px;
    font-weight: 900;
}

QLabel#PageTitle {
    color: #f8fafc;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.3px;
}

QLabel#SectionLabel {
    color: #f59e0b;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

QLabel#TopStatus {
    color: #94a3b8;
    background: #141722;
    border: 1px solid #23283a;
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#Metric {
    color: #f59e0b;
    font-size: 13px;
    font-weight: 700;
}

QLabel#MetricChip {
    color: #cbd5e1;
    background: #161924;
    border: 1px solid #262b3d;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#TrainingSampleLine {
    color: #cbd5e1;
    background: #12141d;
    border: 1px solid #232738;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: Consolas, monospace;
    font-size: 12px;
}

QLabel#MessageMeta {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    background: #141722;
    color: #f8fafc;
    border: 1px solid #282e42;
    border-radius: 7px;
    padding: 5px 8px;
    min-height: 22px;
    selection-background-color: #f59e0b;
    selection-color: #000000;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #f59e0b;
    background: #181b28;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #0f1118;
    color: #64748b;
    border-color: #1e2230;
}

QComboBox {
    background: #141722;
    color: #f8fafc;
    border: 1px solid #282e42;
    border-radius: 7px;
    padding: 5px 24px 5px 10px;
    min-height: 22px;
}

QComboBox:focus, QComboBox:on {
    border-color: #f59e0b;
    background: #181b28;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #282e42;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    background: #171b26;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #cbd5e1;
    margin-right: 2px;
}

QComboBox::down-arrow:hover {
    border-top: 5px solid #f59e0b;
}

QComboBox QAbstractItemView {
    background-color: #151821;
    color: #f8fafc;
    selection-background-color: #262b3d;
    selection-color: #f59e0b;
    border: 1px solid #2e354b;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 4px 8px;
    color: #f8fafc;
    background-color: #151821;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #1e2332;
    color: #fbbf24;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #262b3d;
    color: #fbbf24;
}

QTabWidget::pane {
    border: 1px solid #232738;
    border-radius: 8px;
    background: #11131c;
    top: -1px;
}

QTabBar::tab {
    background: #141722;
    color: #94a3b8;
    border: 1px solid #232738;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 14px;
    margin-right: 3px;
    font-size: 11px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #1a1d29;
    color: #ffffff;
    border-color: #333a4d;
}

QTabBar::tab:selected {
    background: #11131c;
    color: #f59e0b;
    border: 1px solid #232738;
    border-top: 2px solid #f59e0b;
    border-bottom: 1px solid #11131c;
}

QCheckBox {
    color: #cbd5e1;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background: #141722;
    border: 1px solid #333a4d;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #f59e0b;
    background: #181b28;
}

QCheckBox::indicator:checked {
    background: #f59e0b;
    border-color: #fbbf24;
}

QTreeView::indicator, QTreeWidget::indicator {
    width: 14px;
    height: 14px;
    background: #141722;
    border: 1px solid #333a4d;
    border-radius: 3px;
}

QTreeView::indicator:hover, QTreeWidget::indicator:hover {
    border-color: #f59e0b;
    background: #181b28;
}

QTreeView::indicator:checked, QTreeWidget::indicator:checked {
    background: #f59e0b;
    border-color: #fbbf24;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #1e2230;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    height: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #f59e0b, stop:1 #fbbf24);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -4px 0;
    background: #fbbf24;
    border: 2px solid #ffffff;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 2px solid #f59e0b;
}

QPushButton {
    background: #1e2230;
    color: #e2e8f0;
    border: 1px solid #333a4d;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background: #282f44;
    border-color: #4b5563;
    color: #ffffff;
}

QPushButton:pressed {
    background: #141722;
    border-color: #f59e0b;
}

QPushButton:disabled {
    background: #12141b;
    color: #475569;
    border-color: #1e2230;
}

QPushButton#PrimaryAction, QPushButton#ApplyBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #f59e0b, stop:1 #d97706);
    color: #000000;
    border: none;
    border-radius: 8px;
    font-weight: 800;
}

QPushButton#PrimaryAction:hover, QPushButton#ApplyBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fbbf24, stop:1 #f59e0b);
    color: #000000;
}

QPushButton#NavButton {
    background: transparent;
    color: #94a3b8;
    border: 1px solid transparent;
    border-radius: 8px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#NavButton:hover {
    background: #181b26;
    color: #f8fafc;
    border-color: #2b3245;
}

QPushButton#NavButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(245, 158, 11, 0.18), stop:1 rgba(245, 158, 11, 0.05));
    color: #fbbf24;
    border: 1px solid #f59e0b;
    font-weight: 700;
}

QTextEdit {
    background: #0d0f14;
    color: #e2e8f0;
    border: 1px solid #232738;
    border-radius: 8px;
    padding: 8px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

QTableWidget, QTreeWidget {
    background: #11131c;
    alternate-background-color: #151824;
    color: #e2e8f0;
    border: 1px solid #232738;
    border-radius: 8px;
    gridline-color: #1e2232;
    selection-background-color: #2a2215;
    selection-color: #fbbf24;
}

QTableWidget::item, QTreeWidget::item {
    padding: 4px 6px;
}

QHeaderView::section {
    background: #151822;
    color: #f59e0b;
    border: 0;
    border-right: 1px solid #232738;
    border-bottom: 1px solid #232738;
    padding: 6px 8px;
    font-weight: 700;
    font-size: 11px;
}

QScrollBar:vertical {
    background: #0d0e14;
    width: 8px;
    margin: 2px 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #2b3245;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #f59e0b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0d0e14;
    height: 8px;
    margin: 0 2px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #2b3245;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #f59e0b;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QMenuBar {
    background: #10121a;
    color: #cbd5e1;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background: #1e2332;
    color: #fbbf24;
}

QMenu {
    background: #151822;
    color: #f8fafc;
    border: 1px solid #282e42;
    padding: 4px;
    border-radius: 8px;
}

QMenu::item {
    padding: 6px 28px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #262b3d;
    color: #fbbf24;
}

QMenu::separator {
    height: 1px;
    background: #232738;
    margin: 4px 8px;
}

QProgressBar {
    background: #141722;
    border: 1px solid #232738;
    border-radius: 6px;
    min-height: 16px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    font-size: 11px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #10b981, stop:1 #34d399);
    border-radius: 5px;
}

QProgressBar#HardwareMeter {
    background: #141722;
    border: 1px solid #232738;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#HardwareMeter::chunk {
    background: #f59e0b;
    border-radius: 3px;
}
