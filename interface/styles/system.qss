* { font-family: Arial; }

QMainWindow, QWidget#AppShell, QStackedWidget {
    background: #f5f5f5;
    color: #202020;
}

QWidget#TopBar {
    background: #ededed;
    border-bottom: 1px solid #b8b8b8;
}

QWidget#SideRail {
    background: #f0f0f0;
    border-right: 1px solid #b8b8b8;
}

QWidget#Panel {
    background: #f7f7f7;
    color: #202020;
}

QWidget#Page, QWidget#PageContent {
    background: #f7f7f7;
    color: #202020;
}

QWidget#Card {
    background: #ffffff;
    border: 1px solid #c4c4c4;
    border-radius: 8px;
}

QWidget#LossChart {
    background: #ffffff;
    border: 1px solid #c4c4c4;
    border-radius: 8px;
}

QLabel {
    color: #202020;
    font-size: 13px;
}

QLabel#Logo {
    color: #f5b041;
    font-size: 23px;
    font-weight: 900;
}

QLabel#PageTitle {
    color: #151515;
    font-size: 24px;
    font-weight: 700;
}

QLabel#SectionLabel {
    color: #f5b041;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
}

QLabel#TopStatus {
    color: #29451b;
    background: #f2f7ec;
    border: 1px solid #7aa844;
    border-radius: 7px;
    padding: 5px 8px;
    font-size: 12px;
}

QLabel#Metric {
    color: #476d21;
    font-size: 14px;
    font-weight: 700;
}

QLabel#MetricChip {
    color: #29451b;
    background: #f7fbf3;
    border: 1px solid #7aa844;
    border-radius: 7px;
    padding: 7px 10px;
    font-size: 12px;
    font-weight: 800;
}

QLabel#TrainingSampleLine {
    color: #29451b;
    background: #f7fbf3;
    border: 1px solid #7aa844;
    border-radius: 6px;
    padding: 5px 10px;
    font-family: Arial;
    font-size: 12px;
}

QLabel#MessageMeta {
    color: #476d21;
    font-size: 11px;
    font-weight: 700;
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    background: #f5f5f5;
    color: #202020;
    border: 1px solid #8a8a8a;
    border-radius: 7px;
    padding: 5px 8px;
    min-height: 20px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #f5b041;
    background: #f7f7f7;
}

QComboBox {
    background: #f5f5f5;
    color: #202020;
    border: 1px solid #8a8a8a;
    border-radius: 7px;
    padding: 5px 24px 5px 8px;
    min-height: 20px;
}

QComboBox:focus, QComboBox:on {
    border-color: #f5b041;
    background: #f7f7f7;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #444444;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background: #e8e8e8;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #303030;
    margin-right: 2px;
}

QComboBox::down-arrow:hover {
    border-top: 5px solid #f5b041;
}

QComboBox QAbstractItemView {
    background-color: #e8e8e8;
    color: #202020;
    selection-background-color: #b8b8b8;
    selection-color: #f5b041;
    border: 1px solid #8a8a8a;
    border-radius: 4px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 4px 8px;
    color: #202020;
    background-color: #e8e8e8;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #eeeeee;
    color: #f5b041;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #b8b8b8;
    color: #f5b041;
}

QTabWidget::pane {
    border: 1px solid #b8b8b8;
    border-radius: 6px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: #ededed;
    color: #202020;
    border: 1px solid #b8b8b8;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 14px;
    margin-right: 3px;
    font-size: 11px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #eeeeee;
    color: #ffffff;
    border-color: #8a8a8a;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #f5b041;
    border: 1px solid #b8b8b8;
    border-top: 2px solid #f5b041;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QCheckBox {
    color: #202020;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background: #f5f5f5;
    border: 1px solid #8a8a8a;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border-color: #f5b041;
    background: #f0f0f0;
}

QCheckBox::indicator:checked {
    background: #c94343;
    border-color: #f07171;
}

QCheckBox::indicator:checked:hover {
    background: #e05a5a;
    border-color: #ff9292;
}

QTreeView::indicator, QTreeWidget::indicator {
    width: 14px;
    height: 14px;
    background: #f5f5f5;
    border: 1px solid #8a8a8a;
    border-radius: 3px;
}

QTreeView::indicator:hover, QTreeWidget::indicator:hover {
    border-color: #f5b041;
    background: #f0f0f0;
}

QTreeView::indicator:checked, QTreeWidget::indicator:checked {
    background: #c94343;
    border-color: #f07171;
}

QTreeView::indicator:checked:hover, QTreeWidget::indicator:checked:hover {
    background: #e05a5a;
    border-color: #ff9292;
}

QPushButton {
    background: #ffffff;
    color: #202020;
    border: 1px solid #8a8a8a;
    border-radius: 7px;
    padding: 7px 12px;
    font-weight: 800;
}

QPushButton:hover {
    background: #f5b041;
    color: #151515;
    border-color: #ffd27a;
}

QPushButton:pressed {
    background: #c98216;
    color: #f5f5f5;
    border-color: #f5b041;
}

QPushButton:disabled {
    background: #e8e8e8;
    color: #6a6a6a;
    border-color: #b8b8b8;
}

QPushButton#NavButton {
    background: #f2f2f2;
    color: #202020;
    border: 1px solid #a0a0a0;
    border-radius: 8px;
    min-width: 52px;
    min-height: 52px;
    padding: 0;
    font-size: 12px;
}

QPushButton#NavButton:checked, QPushButton#NavButton:hover {
    background: #f5b041;
    color: #151515;
    border-color: #ffd27a;
}

QPushButton#MessageAction {
    background: transparent;
    color: #303030;
    border: 0;
    border-radius: 4px;
    padding: 0;
}

QPushButton#MessageAction:hover {
    color: #f5b041;
    background: #282828;
}

QPushButton#MessageAction:checked {
    color: #151515;
    background: #f5b041;
}

QTextEdit {
    background: #f5f5f5;
    color: #202020;
    border: 1px solid #8a8a8a;
    border-radius: 8px;
    padding: 8px;
    font-family: Consolas;
    font-size: 12px;
}

QTableWidget, QTreeWidget {
    background: #f5f5f5;
    alternate-background-color: #1b1b1b;
    color: #202020;
    border: 1px solid #8a8a8a;
    border-radius: 7px;
    gridline-color: #b8b8b8;
    selection-background-color: #3a2d19;
    selection-color: #ffffff;
}

QTableWidget::item, QTreeWidget::item {
    background: #f5f5f5;
    color: #202020;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background: #3a2d19;
    color: #ffffff;
}

QHeaderView::section {
    background: #f2f2f2;
    color: #f5b041;
    border: 0;
    border-right: 1px solid #c4c4c4;
    border-bottom: 1px solid #c4c4c4;
    padding: 6px 8px;
    font-weight: 800;
}

QScrollBar:vertical {
    background: #f0f0f0;
    width: 8px;
    margin: 2px 0;
}

QScrollBar::handle:vertical {
    background: #c98216;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #f5b041;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #f0f0f0;
    height: 8px;
    margin: 0 2px;
}

QScrollBar::handle:horizontal {
    background: #c98216;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #f5b041;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QMenuBar {
    background: #ededed;
    color: #202020;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background: #f5b041;
    color: #151515;
}

QMenu {
    background: #ffffff;
    color: #202020;
    border: 1px solid #8a8a8a;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #f5b041;
    color: #151515;
}

QMenu::separator {
    height: 1px;
    background: #c4c4c4;
    margin: 4px 8px;
}

QTextBrowser {
    background: #f5f5f5;
    color: #202020;
    border: 1px solid #8a8a8a;
    border-radius: 8px;
    padding: 12px;
    font-family: Arial;
    font-size: 14px;
}

QDialog {
    background: #f7f7f7;
    color: #202020;
}

QDialog QLabel#Title {
    color: #f5b041;
    font-size: 24px;
}

QDialog QLabel#Subtitle, QDialog QLabel#Step, QDialog QLabel#Body, QDialog QLabel#CardBody {
    color: #202020;
}

QDialog QLabel#CardTitle {
    color: #151515;
    font-size: 16px;
}

QWidget#ChoiceCard, QListWidget {
    background: #f0f0f0;
    color: #202020;
    border: 1px solid #b8b8b8;
    border-radius: 8px;
}

QListWidget {
    padding: 4px;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background: #3a2d19;
    color: #ffffff;
}

QScrollArea {
    background: #f7f7f7;
    border: 0;
}

QScrollArea::viewport {
    background: #f7f7f7;
}

QScrollArea#ChatScroll {
    background: #f5f5f5;
    border: 0;
    border-radius: 0;
}

QScrollArea#PageScroll {
    background: #f7f7f7;
    border: 0;
    border-radius: 0;
}

QWidget#ChatCanvas {
    background: #f5f5f5;
}

QMessageBox {
    background: #ffffff;
    color: #202020;
}

QMessageBox QLabel {
    color: #202020;
}

QMessageBox QPushButton {
    min-width: 64px;
}

QWidget#UserBubble {
    background: #fff7e8;
    border: 1px solid #b66a00;
    border-radius: 8px;
}

QWidget#AssistantBubble {
    background: transparent;
    border: 0;
    border-radius: 0;
}

QTextBrowser#BubbleText {
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 2px;
}

QPushButton#ThoughtToggle {
    background: #181b22;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
    text-align: left;
}

QPushButton#ThoughtToggle:hover {
    background: #222734;
    color: #cbd5e1;
    border-color: #475569;
}

QTextBrowser#ThoughtText {
    background: #13161d;
    color: #94a3b8;
    border-left: 3px solid #6366f1;
    border-top: 0;
    border-right: 0;
    border-bottom: 0;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

QTextEdit#ChatInput, QTextEdit#SystemPrompt {
    background: #f5f5f5;
    color: #202020;
    border: 1px solid #8a8a8a;
    border-radius: 8px;
    padding: 8px;
    font-family: Arial;
    font-size: 13px;
}

QProgressBar {
    background: #eeeeee;
    border: 0;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar::chunk {
    background: #f5b041;
    border-radius: 2px;
}

QProgressBar#HardwareMeter {
    background: #e8e8e8;
    border: 0;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#HardwareMeter::chunk {
    background: #f5b041;
    border-radius: 4px;
}
